{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the user"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user entered during registration"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user registered"
        }
      },
      "required": [
        "email",
        "createdAt",
        "name"
      ]
    },
    "ClientFile": {
      "title": "ClientFile",
      "description": "Secure file and its metadata uploaded by clients/users",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Original file name"
        },
        "size": {
          "type": "integer",
          "description": "File size in bytes"
        },
        "type": {
          "type": "string",
          "description": "MIME type of the file"
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of when the file was uploaded"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this file"
        },
        "content": {
          "type": "string",
          "description": "Base64 encoded data-URL of the uploaded file"
        }
      },
      "required": [
        "name",
        "size",
        "type",
        "uploadedAt",
        "ownerId",
        "content"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message sent between an administrator and a tenant",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "UID of the user who sent this message"
        },
        "senderEmail": {
          "type": "string",
          "description": "Email address of the sender"
        },
        "text": {
          "type": "string",
          "description": "Textual payload of the message"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when message was dispatched"
        },
        "readByAdmin": {
          "type": "boolean",
          "description": "Flags whether the administrator read this message"
        },
        "readByClient": {
          "type": "boolean",
          "description": "Flags whether the client read this message"
        }
      },
      "required": [
        "senderId",
        "senderEmail",
        "text",
        "timestamp",
        "readByAdmin",
        "readByClient"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user-specific profile records"
    },
    "files/{fileId}": {
      "schema": "ClientFile",
      "description": "Collection of secure user files"
    },
    "chats/{clientId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "High-security nested chat messages collection for individual communication channels"
    }
  }
}
